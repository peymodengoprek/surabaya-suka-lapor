# ==========================================
# Surabaya Suka Lapor - Environment Variables
# ==========================================

ASTRO_TELEMETRY_DISABLED=1

# PostgreSQL Connection
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/surabaya_suka_lapor
DATABASE_SSL=false

# Firebase Client Configuration (Dibutuhkan untuk Auth di browser)
PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=your_project_id
PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# Firebase Admin Configuration (Dibutuhkan untuk verifikasi token di server SSR)
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
# Format private key: jika ada newline ganti dengan \n atau masukkan multi-line string dengan tanda petik
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

---
// Header layout komponen
---

<header class="bg-white border-b border-gray-200 px-4 py-3 sticky top-0 z-30 shadow-sm">
  <div class="max-w-7xl mx-auto flex flex-col sm:flex-row sm:items-center justify-between gap-3">
    
    <!-- Judul & Subjudul -->
    <div>
      <a href="/" class="text-xl font-bold text-gray-900 hover:text-blue-600 transition">
        Surabaya Suka Lapor
      </a>
      <p class="text-xs text-gray-500">
        Peta Laporan Jalan Rusak Surabaya &bull; Suara Warga Transparan
      </p>
    </div>

    <!-- Quick Auth Bar -->
    <div class="flex items-center gap-3">
      <!-- Status Pengunjung Publik -->
      <div id="nav-guest" class="flex items-center gap-2">
        <span class="text-xs bg-gray-100 text-gray-700 px-2.5 py-1 rounded border border-gray-300">
          Pengunjung Publik
        </span>
        <button
          id="nav-btn-login"
          type="button"
          class="bg-blue-600 hover:bg-blue-700 text-white text-xs font-medium px-3 py-1.5 rounded cursor-pointer transition"
        >
          Masuk dengan Google
        </button>
      </div>

      <!-- Status Pengguna Login -->
      <div id="nav-user" class="hidden items-center gap-2">
        <span class="text-xs text-gray-700">
          Masuk sebagai: <strong id="nav-user-name" class="font-bold text-gray-900">...</strong>
        </span>
        <button
          id="nav-btn-logout"
          type="button"
          class="bg-red-600 hover:bg-red-700 text-white text-xs px-2.5 py-1 rounded cursor-pointer transition"
        >
          Keluar
        </button>
      </div>

      <a
        href="/api/health"
        target="_blank"
        class="text-xs bg-gray-100 hover:bg-gray-200 text-gray-600 px-2 py-1 rounded border font-mono"
        title="Status Server & Database"
      >
        API Status
      </a>
    </div>

  </div>
</header>

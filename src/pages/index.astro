---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import SearchBar from '../components/map/SearchBar.astro';
import CategoryFilter from '../components/map/CategoryFilter.astro';
import MapContainer from '../components/map/MapContainer.astro';

export const prerender = false;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Surabaya Suka Lapor - Peta Jalan Rusak Surabaya</title>
  </head>
  <body class="bg-gray-100 text-gray-900 font-sans min-h-screen flex flex-col">
    
    <!-- Header Navigasi & Status Auth -->
    <Header />

    <!-- Area Konten Utama -->
    <main class="flex-1 max-w-7xl w-full mx-auto p-3 sm:p-4 md:p-6 space-y-3">
      
      <!-- Panel Kontrol: Pencarian Lokasi & Filter Kategori -->
      <section class="bg-white p-3 sm:p-4 rounded-lg border border-gray-200 shadow-xs space-y-3">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-3">
          <!-- Kolom Pencarian Lokasi -->
          <SearchBar />

          <!-- Keterangan Cepat -->
          <div class="text-xs text-gray-500">
            Klik penanda merah pada peta untuk melihat kategori dan keterangan singkat kerusakan.
          </div>
        </div>

        <!-- Filter Kategori Kerusakan -->
        <div class="pt-2 border-t border-gray-100">
          <CategoryFilter />
        </div>
      </section>

      <!-- Komponen Peta Interaktif Leaflet -->
      <section>
        <MapContainer />
      </section>

      <!-- Informasi Publik & Catatan Data -->
      <section class="bg-white p-3.5 rounded-lg border border-gray-200 text-xs text-gray-600 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2 shadow-xs">
        <div>
          <strong>Akses Publik Bebas:</strong> Warga Surabaya dapat mencari alamat dan memantau seluruh laporan jalan tanpa perlu login.
        </div>
        <div class="text-[11px] text-gray-500 font-mono">
          Peta & Pencarian: Leaflet + OpenStreetMap
        </div>
      </section>

    </main>

    <!-- Footer -->
    <footer class="bg-white border-t border-gray-200 py-3 text-center text-xs text-gray-500">
      Surabaya Suka Lapor &bull; Platform Pantau Jalan Rusak Kota Surabaya
    </footer>

    <!-- Inisialisasi Logika Controller Peta -->
    <script>
      import { MapPageController } from '../lib/map/map-controller';

      // Jalankan controller halaman peta
      const controller = new MapPageController();
      controller.init();
    </script>
  </body>
</html>
